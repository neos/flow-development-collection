{
    "name": "neos/flow-log",
    "type": "package",
    "description": "Flow Framework Logger",
    "homepage": "http://flow.neos.io",
    "license": [
        "MIT"
    ],
    "require": {
        "php": "^8.0",
        "psr/log": "^2.0 || ^3.0",
        "neos/utility-files": "self.version"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.3"
    },
    "autoload": {
        "psr-4": {
            "Neos\\Flow\\Log\\": "Classes"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Neos\\Flow\\Log\\Tests\\": "Tests"
        }
    },
    "provide": {
        "psr/log-implementation": "2.0.0 || 3.0.0"
    },
    "extra": {
        "neos": {
            "package-key": "Neos.Flow.Log"
        }
    }
}
